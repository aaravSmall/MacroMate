# Copy to .env and fill in. Never commit real values (.env is gitignored).

# --- App (bundled into the app: public values only) ---------------------------------------
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JavaScript bundle, so only use the
# project URL and the publishable/anon key here. Find both in Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Local admin scripts (never in the app) ----------------------------------------------
# Used by `npm run demo:clear` (read from the shell environment) and by
# `npm run restaurants:upload` (read from scripts/restaurants/.env.local; see its .example).
# The secret / service role key bypasses Row Level Security: keep it out of git and the app.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# --- Edge Function secrets (set in Supabase, not here) -----------------------------------
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and SUPABASE_SECRET_KEYS are provided to Edge
# Functions automatically. Set the rest with `npx supabase secrets set NAME=value`:
# DINING_CRON_SECRET=   # shared secret the scheduled sync-dining job sends
