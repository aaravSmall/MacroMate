{
  "expo": {
    "name": "Tally",
    "slug": "calorie-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calorietracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aaravsmall.calorietracker",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.aaravsmall.calorietracker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tally reads the Nutrition Facts panel in a photo you choose, on your device. The photo is never uploaded or saved.",
          "cameraPermission": "Tally uses the camera to photograph a Nutrition Facts panel and read it on your device. The photo is never uploaded or saved.",
          "microphonePermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Tally reads your workouts and active energy from Apple Health so the calories you burn can add to your day. Tally never writes to Apple Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
